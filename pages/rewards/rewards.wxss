.rewards-wrap {
  padding: 32rpx;
  background: #0D0D0D;
  min-height: 100vh;
}

.points-summary {
  background: linear-gradient(135deg, #1A1A1A, #2A1A1A);
  border: 1rpx solid #C8171D;
  border-radius: 16rpx;
  padding: 48rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

.summary-label {
  display: block;
  font-size: 24rpx;
  color: #888888;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.summary-points {
  display: block;
  font-size: 96rpx;
  font-weight: bold;
  color: #FFFFFF;
  line-height: 1;
  margin-bottom: 16rpx;
}

.summary-cum {
  display: block;
  font-size: 24rpx;
  color: #888888;
}

.section-title {
  font-size: 22rpx;
  color: #888888;
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

/* 等级卡片 */
.reward-card {
  border-radius: 12rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 20rpx;
}

.card-unlocked {
  background: #1A1A1A;
  border: 1rpx solid #AAAAAA;
}

.card-unlocked-gold {
  background: #1A1500;
  border: 1rpx solid #C9A84C;
}

.card-locked {
  background: #141414;
  border: 1rpx solid #2A2A2A;
}

.reward-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.reward-tier-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.reward-tier-name.silver { color: #CCCCCC; }
.reward-tier-name.gold { color: #C9A84C; }

.reward-tier-desc {
  font-size: 26rpx;
  color: #888888;
}

.status-unlocked { font-size: 26rpx; color: #4CAF50; }
.status-unlocked-gold { font-size: 26rpx; color: #C9A84C; }
.status-locked { font-size: 22rpx; color: #666666; }

.reward-progress-bar {
  height: 6rpx;
  background: #2A2A2A;
  border-radius: 6rpx;
  overflow: hidden;
}

.reward-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #C8171D, #FF4444);
}

.gold-fill {
  background: linear-gradient(90deg, #C9A84C, #FFD700);
}

/* 葡萄酒兑换卡片 */
.wine-card {
  background: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 16rpx;
  padding: 36rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.wine-card-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.wine-icon { font-size: 64rpx; }

.wine-name {
  display: block;
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.wine-price {
  display: block;
  font-size: 22rpx;
  color: #888888;
  margin-bottom: 6rpx;
  text-decoration: line-through;
}

.wine-cost {
  display: block;
  font-size: 24rpx;
  color: #C8171D;
  font-weight: bold;
}

.redeem-btn-active {
  background: #C8171D;
  color: #FFFFFF;
  border: none;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: bold;
  padding: 20rpx 28rpx;
  white-space: nowrap;
}

.redeem-btn-active::after { border: none; }

.redeem-btn-disabled {
  background: #2A2A2A;
  color: #666666;
  border: none;
  border-radius: 8rpx;
  font-size: 26rpx;
  padding: 20rpx 28rpx;
  white-space: nowrap;
}

.redeem-btn-disabled::after { border: none; }

/* 说明 */
.exchange-tips {
  background: #141414;
  border-radius: 12rpx;
  padding: 32rpx;
}

.tips-title-sm {
  display: block;
  font-size: 22rpx;
  color: #888888;
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.loading-wrap {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 核销码弹层 */
.redeem-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.redeem-card {
  background: #1A1A1A;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  width: 560rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid #2A2A2A;
}
.redeem-icon { font-size: 64rpx; margin-bottom: 16rpx; }
.redeem-title { font-size: 36rpx; font-weight: bold; color: #4CAF50; margin-bottom: 8rpx; }
.redeem-reward-name { font-size: 28rpx; color: #888; margin-bottom: 32rpx; }
.redeem-code-box {
  background: #0D0D0D;
  border: 2rpx dashed #C8171D;
  border-radius: 16rpx;
  padding: 24rpx 48rpx;
  text-align: center;
  margin-bottom: 24rpx;
  width: 100%;
}
.redeem-code-label { font-size: 22rpx; color: #888; display: block; margin-bottom: 8rpx; }
.redeem-code { font-size: 56rpx; font-weight: bold; color: #C8171D; letter-spacing: 8rpx; display: block; }
.redeem-code-tip { font-size: 22rpx; color: #666; display: block; margin-top: 8rpx; }
.redeem-info { width: 100%; margin-bottom: 24rpx; }
.redeem-info-item { display: block; font-size: 24rpx; color: #888; margin-bottom: 8rpx; text-align: center; }
.redeem-close-btn {
  width: 100%;
  background: #C8171D;
  color: #FFF;
  border: none;
  border-radius: 9999rpx;
  font-size: 28rpx;
  padding: 24rpx 0;
}
.redeem-close-btn::after { border: none; }
