.splash {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #0D0D0D;
}
.logo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.brand-en {
  font-size: 72rpx;
  font-weight: bold;
  color: #C8171D;
  letter-spacing: 12rpx;
}
.brand-sub {
  font-size: 24rpx;
  color: #888888;
  letter-spacing: 6rpx;
}
.brand-year {
  font-size: 28rpx;
  color: #FFFFFF;
  letter-spacing: 4rpx;
  margin-top: 8rpx;
}
.loading-text {
  color: #555555;
  font-size: 24rpx;
  margin-top: 80rpx;
  letter-spacing: 4rpx;
}
