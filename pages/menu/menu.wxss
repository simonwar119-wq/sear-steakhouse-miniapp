/* pages/menu/menu.wxss */
page {
  background-color: #0D0D0D;
}

.menu-wrap {
  background-color: #0D0D0D;
  min-height: 100vh;
  padding-bottom: 80rpx;
}

/* ── Header ── */
.menu-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 24rpx;
}

.header-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 12rpx;
}

.header-sub {
  font-size: 24rpx;
  color: #888888;
  letter-spacing: 6rpx;
  margin-top: 6rpx;
}

/* ── Category Tabs ── */
.tab-scroll {
  width: 100%;
  white-space: nowrap;
}

.tab-bar {
  display: flex;
  flex-direction: row;
  padding: 0 24rpx 0;
  gap: 12rpx;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 28rpx;
  border-radius: 50rpx;
  border: 1rpx solid #2A2A2A;
  background: #1A1A1A;
  transition: all 0.2s;
  flex-shrink: 0;
}

.tab-item:active {
  transform: scale(0.95);
}

.tab-active {
  background: #C8171D;
  border-color: #C8171D;
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.tab-name {
  font-size: 24rpx;
  color: #999999;
  font-weight: 500;
}

.tab-active .tab-name {
  color: #ffffff;
  font-weight: 600;
}

/* ── Category subtitle ── */
.cat-subtitle {
  padding: 16rpx 32rpx 8rpx;
}

.cat-en {
  font-size: 22rpx;
  color: #444444;
  letter-spacing: 4rpx;
}

/* ── Items List ── */
.items-list {
  padding: 8rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item-card {
  background: #1A1A1A;
  border: 1rpx solid #242424;
  border-radius: 20rpx;
  overflow: hidden;
}

/* 图片 */
.item-img-wrap {
  width: 100%;
  height: 340rpx;
  position: relative;
}

.item-img {
  width: 100%;
  height: 100%;
  display: block;
}

.item-img-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #C8171D;
  border-radius: 8rpx;
  padding: 8rpx 18rpx;
}

.badge-text {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* 文字区 */
.item-body {
  padding: 28rpx 28rpx 24rpx;
}

.item-name-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.item-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
  margin-bottom: 4rpx;
}

.item-en {
  display: block;
  font-size: 22rpx;
  color: #666666;
  letter-spacing: 1rpx;
}

.item-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #C8171D;
  letter-spacing: 1rpx;
  white-space: nowrap;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.item-desc {
  font-size: 26rpx;
  color: #888888;
  line-height: 1.7;
  display: block;
  margin-bottom: 14rpx;
}

/* Tags */
.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.item-tag {
  font-size: 20rpx;
  color: #C8171D;
  border: 1rpx solid rgba(200,23,29,0.4);
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
  letter-spacing: 1rpx;
}

/* ── Footer ── */
.menu-footer {
  margin-top: 48rpx;
  padding: 32rpx 24rpx 20rpx;
  border-top: 1rpx solid #1A1A1A;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.footer-note {
  font-size: 22rpx;
  color: #444444;
  letter-spacing: 2rpx;
  text-align: center;
}

.footer-hotline {
  font-size: 24rpx;
  color: #666666;
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}
