/* pages/home/home.wxss */
page {
  background-color: #0D0D0D;
  margin: 0;
  padding: 0;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #0D0D0D;
}

/* ── Hero ── */
.hero {
  width: 100%;
  height: 520rpx;
  position: relative;
  overflow: hidden;
}

.hero-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
}

.hero-scrim {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(
    to bottom,
    rgba(13,13,13,0.25) 0%,
    rgba(13,13,13,0.55) 50%,
    rgba(13,13,13,0.90) 100%
  );
}

.hero-overlay {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 0 36rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

/* 品牌组合 */
.brand-lockup {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.hero-xi {
  font-size: 64rpx;
  font-weight: 900;
  color: #C8171D;
  line-height: 1;
}

.brand-right {
  display: flex;
  flex-direction: column;
}

.hero-brand {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 6rpx;
  line-height: 1;
}

.hero-tagline {
  font-size: 22rpx;
  color: #C8171D;
  letter-spacing: 4rpx;
  margin-top: 4rpx;
}

.hero-sub {
  font-size: 20rpx;
  color: rgba(255,255,255,0.55);
  letter-spacing: 3rpx;
  margin-bottom: 14rpx;
}

/* meta info */
.hero-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.hero-meta-item {
  font-size: 22rpx;
  color: rgba(255,255,255,0.70);
}

.hero-meta-dot {
  font-size: 18rpx;
  color: rgba(255,255,255,0.35);
}

/* hours badge */
.hero-hours-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(200,23,29,0.18);
  border: 1rpx solid rgba(200,23,29,0.45);
  border-radius: 40rpx;
  padding: 10rpx 24rpx;
}

.hours-dot {
  width: 12rpx;
  height: 12rpx;
  background: #C8171D;
  border-radius: 50%;
}

.hours-text {
  font-size: 22rpx;
  color: #ff8a8a;
  letter-spacing: 2rpx;
  font-weight: 500;
}

/* Theme toggle */
.theme-toggle {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(0,0,0,0.45);
  border: 1rpx solid rgba(255,255,255,0.15);
  border-radius: 40rpx;
  padding: 10rpx 20rpx;
}

.theme-toggle:active { opacity: 0.7; }

.toggle-icon { font-size: 26rpx; }

.toggle-text {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* ── Section ── */
.section {
  padding: 32rpx 24rpx 0;
}

.section-header {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.section-en {
  font-size: 20rpx;
  color: #555555;
  letter-spacing: 3rpx;
}

/* ── 精选招牌 ── */
.feat-scroll {
  width: 100%;
  white-space: nowrap;
  margin-left: -24rpx;
  padding: 0 24rpx;
  width: calc(100% + 48rpx);
  box-sizing: border-box;
}

.feat-list {
  display: flex;
  gap: 16rpx;
  padding-right: 24rpx;
}

.feat-card {
  flex-shrink: 0;
  width: 240rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #1A1A1A;
  border: 1rpx solid #242424;
}

.feat-card:active { opacity: 0.8; transform: scale(0.97); }

.feat-img {
  width: 240rpx;
  height: 200rpx;
  display: block;
}

.feat-info {
  padding: 14rpx 16rpx 16rpx;
}

.feat-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 4rpx;
}

.feat-tag {
  font-size: 22rpx;
  color: #C8171D;
}

/* ── Nav Grid ── */
.nav-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.nav-card {
  width: calc(50% - 8rpx);
  background: #1A1A1A;
  border: 1rpx solid #242424;
  border-radius: 20rpx;
  padding: 28rpx 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-sizing: border-box;
}

.nav-card:active {
  background: #222222;
  border-color: #C8171D;
  transform: scale(0.97);
}

.nav-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.nav-icon-wrap.red { background: rgba(200,23,29,0.15); }
.nav-icon-wrap.dark { background: rgba(255,255,255,0.06); }
.nav-icon-wrap.gold { background: rgba(201,168,76,0.15); }

.nav-icon { font-size: 40rpx; }

.nav-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 6rpx;
  letter-spacing: 1rpx;
}

.nav-desc {
  font-size: 22rpx;
  color: #666666;
}

/* ── 品质承诺 ── */
.promise-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  background: #1A1A1A;
  border: 1rpx solid #242424;
  border-radius: 20rpx;
  overflow: hidden;
}

.promise-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #242424;
}

.promise-item:last-child { border-bottom: none; }

.promise-icon {
  font-size: 40rpx;
  width: 48rpx;
  text-align: center;
  flex-shrink: 0;
}

.promise-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.promise-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.promise-desc {
  font-size: 24rpx;
  color: #888888;
}

/* ── 环境展示 ── */
.env-grid {
  display: flex;
  gap: 12rpx;
  height: 320rpx;
}

.env-large {
  flex: 2;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.env-small {
  flex: 1;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.env-img {
  width: 100%;
  height: 100%;
}

.env-caption {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 60rpx 16rpx 16rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.72));
}

.env-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.85);
  letter-spacing: 2rpx;
}

/* ── Footer ── */
.footer {
  padding: 48rpx 24rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  border-top: 1rpx solid #1A1A1A;
  margin-top: 36rpx;
}

.footer-brand {
  font-size: 26rpx;
  color: #666666;
  letter-spacing: 2rpx;
  font-weight: 500;
}

.footer-addr {
  font-size: 22rpx;
  color: #444444;
  letter-spacing: 1rpx;
}

.footer-hours {
  font-size: 20rpx;
  color: #3A3A3A;
}

.admin-entry {
  font-size: 20rpx;
  color: transparent;
  padding: 20rpx;
}

/* ── 关于我们 ── */
.section-about {
  padding: 32rpx 24rpx 0;
}

.about-story {
  background: #1A1A1A;
  border-radius: 20rpx;
  border: 1px solid #2A2A2A;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.about-story-text {
  font-size: 28rpx;
  color: #dddddd;
  line-height: 1.8;
  letter-spacing: 2rpx;
  display: block;
}

.about-cert {
  background: #1A1A1A;
  border-radius: 20rpx;
  border: 1px solid #2A2A2A;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.about-cert-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.about-cert-badge {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.about-cert-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #C8171D;
  letter-spacing: 2rpx;
  flex: 1;
}

.about-cert-body {
  font-size: 26rpx;
  color: #bbbbbb;
  line-height: 1.7;
  letter-spacing: 2rpx;
}

.about-info-card {
  background: #1A1A1A;
  border-radius: 20rpx;
  border: 1px solid #2A2A2A;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.about-info-row {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
}

.about-info-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
  width: 48rpx;
  text-align: center;
}

.about-info-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.about-info-label {
  font-size: 24rpx;
  color: #888888;
  margin-bottom: 4rpx;
}

.about-info-value {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 500;
}

.about-info-divider {
  height: 1px;
  background: #2A2A2A;
  margin: 0 32rpx;
}

.about-call-btn {
  background: #C8171D;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

.about-call-btn:active {
  background: #a01216;
  transform: scale(0.98);
}

.about-call-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.about-call-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.about-call-number {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}
