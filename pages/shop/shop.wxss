/* pages/shop/shop.wxss — 暗黑红金主题 */
page {
  background-color: #0D0D0D;
}

.shop-wrap {
  background-color: #0D0D0D;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* ── Header ── */
.shop-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
  position: relative;
}

.header-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 16rpx;
}

.header-en {
  font-size: 22rpx;
  color: #C9A84C;
  letter-spacing: 6rpx;
  margin-top: 6rpx;
  font-weight: 500;
}

.header-promo {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  background: linear-gradient(135deg, #C8171D 0%, #8a0f13 100%);
  border-radius: 50rpx;
  padding: 10rpx 32rpx;
}

.promo-tag {
  font-size: 26rpx;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.promo-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #C9A84C;
  letter-spacing: 4rpx;
}

/* ── 配送说明横幅 ── */
.delivery-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 0 24rpx 24rpx;
  padding: 18rpx 0;
  background: #1A1A1A;
  border: 1rpx solid #2A2A2A;
  border-radius: 16rpx;
}

.delivery-icon {
  font-size: 28rpx;
}

.delivery-text {
  font-size: 24rpx;
  color: #C9A84C;
  letter-spacing: 2rpx;
  font-weight: 500;
}

/* ── 商品网格 2列 ── */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
  gap: 16rpx;
}

.goods-card {
  width: calc(50% - 8rpx);
  background: #1A1A1A;
  border: 1rpx solid #242424;
  border-radius: 20rpx;
  overflow: hidden;
  transition: all 0.2s;
}

.goods-card:active {
  transform: scale(0.97);
}

/* 卡片图片 */
.card-img-wrap {
  width: 100%;
  height: 280rpx;
  position: relative;
  overflow: hidden;
}

.card-img {
  width: 100%;
  height: 100%;
  display: block;
}

.card-discount-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: #C8171D;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}

.badge-text {
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* 卡片内容 */
.card-body {
  padding: 20rpx 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

.card-en {
  font-size: 20rpx;
  color: #666666;
  letter-spacing: 1rpx;
  display: block;
}

.card-weight {
  display: inline-flex;
  align-self: flex-start;
  background: rgba(201,168,76,0.12);
  border: 1rpx solid rgba(201,168,76,0.3);
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
  margin: 4rpx 0;
}

.weight-text {
  font-size: 20rpx;
  color: #C9A84C;
  font-weight: 500;
}

/* 价格行 */
.card-price-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
}

.price-original {
  font-size: 26rpx;
  color: #666666;
  text-decoration: line-through;
  font-weight: 400;
}

.price-discount {
  font-size: 32rpx;
  font-weight: 800;
  color: #C8171D;
  letter-spacing: 1rpx;
}

/* 加入购物车按钮 */
.card-action {
  margin-top: 12rpx;
}

.btn-cart {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: linear-gradient(135deg, #C8171D 0%, #8a0f13 100%);
  border: none;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
  letter-spacing: 2rpx;
  padding: 0;
}

.btn-cart::after {
  border: none;
}

.btn-cart:active {
  opacity: 0.85;
}

/* ── 底部固定购物车栏 ── */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #1A1A1A;
  border-top: 2rpx solid #C9A84C;
  z-index: 999;
}

.cart-bar-empty {
  border-top-color: #2A2A2A;
}

.cart-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cart-icon-wrap {
  position: relative;
}

.cart-icon {
  font-size: 44rpx;
}

.cart-count {
  position: absolute;
  top: -8rpx;
  right: -12rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  background: #C8171D;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  border-radius: 50%;
  padding: 0 6rpx;
}

.cart-total-label {
  font-size: 26rpx;
  color: #888888;
}

.cart-total-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #C9A84C;
  letter-spacing: 1rpx;
}

/* 结算按钮 */
.btn-checkout {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 48rpx;
  background: linear-gradient(135deg, #C9A84C 0%, #a08030 100%);
  border: none;
  border-radius: 40rpx;
  font-size: 30rpx;
  color: #0D0D0D;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.btn-checkout::after {
  border: none;
}

.btn-checkout:active {
  opacity: 0.85;
}

.btn-checkout-disabled {
  background: #2A2A2A;
  color: #555555;
  letter-spacing: 2rpx;
}
