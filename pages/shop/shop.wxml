<!-- pages/shop/shop.wxml — 鲜肉铺 RAW MEAT SHOP -->
<view class="shop-wrap">

  <!-- Header -->
  <view class="shop-header">
    <text class="header-title">鲜肉铺</text>
    <text class="header-en">RAW MEAT SHOP</text>
    <view class="header-promo">
      <text class="promo-tag">全场鲜肉</text>
      <text class="promo-num">65折</text>
    </view>
  </view>

  <!-- 配送说明横幅 -->
  <view class="delivery-banner">
    <text class="delivery-icon">🚚</text>
    <text class="delivery-text">到店自提免费 / 天津同城满¥200免运费</text>
  </view>

  <!-- 商品网格 -->
  <view class="goods-grid">
    <view
      class="goods-card"
      wx:for="{{goodsList}}"
      wx:key="id"
    >
      <!-- 图片 -->
      <view class="card-img-wrap">
        <image class="card-img" src="{{item.img}}" mode="aspectFill" lazy-load></image>
        <view class="card-discount-badge">
          <text class="badge-text">65% OFF</text>
        </view>
      </view>

      <!-- 信息 -->
      <view class="card-body">
        <text class="card-name">{{item.name}}</text>
        <text class="card-en">{{item.en}}</text>
        <view class="card-weight">
          <text class="weight-text">{{item.weight}}</text>
        </view>
        <view class="card-price-row">
          <text class="price-original">¥{{item.originalPrice}}</text>
          <text class="price-discount">¥{{item.discountPrice}}</text>
        </view>
        <view class="card-action">
          <button
            class="btn-cart"
            data-id="{{item.id}}"
            bindtap="addToCart"
          >加入购物车</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部固定购物车栏 -->
  <view class="cart-bar" wx:if="{{cartTotal > 0}}">
    <view class="cart-info">
      <view class="cart-icon-wrap">
        <text class="cart-icon">🛒</text>
        <text class="cart-count">{{cartCount}}</text>
      </view>
      <text class="cart-total-label">合计</text>
      <text class="cart-total-num">¥{{cartTotal}}</text>
    </view>
    <button class="btn-checkout" bindtap="onCheckout">去结算</button>
  </view>

  <!-- 购物车为空时底部提示 -->
  <view class="cart-bar cart-bar-empty" wx:else>
    <view class="cart-info">
      <view class="cart-icon-wrap">
        <text class="cart-icon">🛒</text>
        <text class="cart-count">0</text>
      </view>
      <text class="cart-total-label">合计</text>
      <text class="cart-total-num">¥0</text>
    </view>
    <button class="btn-checkout btn-checkout-disabled" disabled>即将开通</button>
  </view>

</view>
